# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Supabase (proyecto hosteado — Dashboard > Project Settings > API keys / Connect) ---
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...           # SOLO servidor/worker. Nunca en el browser.
# Session pooler (IPv4, soporta LISTEN/NOTIFY y advisory locks que necesita pg-boss).
# Copiar de Dashboard > Connect > Session pooler; el usuario es postgres.<PROJECT_REF>.
# La cadena del Dashboard trae [YOUR-PASSWORD]: borrá TAMBIÉN los corchetes, no solo el
# texto de adentro. Si quedan, viajan como parte del password y Postgres tira 28P01.
# Si el password tiene @ : / ? # & → percent-encodearlo o la cadena rompe sin decir por qué.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- WhatsApp Cloud API (Meta) ---
META_APP_ID=
META_APP_SECRET=                 # valida la firma X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=           # string que vos inventás; se pega igual en el panel de Meta
WHATSAPP_API_VERSION=v23.0
# Para desarrollo con el número de prueba (en producción cada clínica tiene el suyo en la tabla clinics)
WHATSAPP_DEV_PHONE_NUMBER_ID=
WHATSAPP_DEV_ACCESS_TOKEN=

# --- LLM (uno solo activo; los demás pueden quedar vacíos) ---
# LLM_PROVIDER=anthropic         # anthropic | openai | google — descomentar en fase 2 (exige la API key del proveedor)
LLM_MODEL=                       # ej. el modelo Sonnet vigente; chequear con `pnpm view` / docs del proveedor
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Transcripción de audios ---
# TRANSCRIBE_PROVIDER=openai     # openai (whisper) | deepgram | google — descomentar en fase 2 (exige la API key del proveedor)
DEEPGRAM_API_KEY=

# --- Simulador ---
CLINIC_SLUG=dental-nova

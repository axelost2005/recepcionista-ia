# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Supabase (local: supabase start te imprime estos valores) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- WhatsApp Cloud API (Meta) ---
META_APP_ID=
META_APP_SECRET=                 # valida la firma X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=           # string que vos inventás; se pega igual en el panel de Meta
WHATSAPP_API_VERSION=v23.0
# Para desarrollo con el número de prueba (en producción cada clínica tiene el suyo en la tabla clinics)
WHATSAPP_DEV_PHONE_NUMBER_ID=
WHATSAPP_DEV_ACCESS_TOKEN=

# --- LLM (uno solo activo; los demás pueden quedar vacíos) ---
LLM_PROVIDER=anthropic           # anthropic | openai | google
LLM_MODEL=                       # ej. el modelo Sonnet vigente; chequear con `pnpm view` / docs del proveedor
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Transcripción de audios ---
TRANSCRIBE_PROVIDER=openai       # openai (whisper) | deepgram | google
DEEPGRAM_API_KEY=

# --- Simulador ---
CLINIC_SLUG=dental-nova
